# Copia este archivo a ".env" y ajusta los valores para tu entorno.
# ".env" está en .gitignore y nunca debe subirse al repositorio.

# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" en desarrollo, "False" en producción.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma (solo se usa cuando DJANGO_DEBUG=False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Backend de correo. En desarrollo se imprime en consola; en producción usa SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@consultorio-contable.local

# Solo aplica cuando DJANGO_DEBUG=False. Déjalo en True salvo que un proxy/balanceador
# ya se encargue de redirigir a HTTPS.
DJANGO_SECURE_SSL_REDIRECT=True
